# Soul Cosmos 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== AI Provider（至少配置一个） =====

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# DeepSeek
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# Qwen (通义千问，阿里云 DashScope)
# DASHSCOPE_API_KEY=sk-your-dashscope-key

# 自定义 OpenAI 兼容端点（支持 Ollama、vLLM、Together、Groq、硅基流动等）
# CUSTOM_API_KEY=sk-your-custom-key
# CUSTOM_PROVIDER_NAME=My Provider
# CUSTOM_HOST=api.example.com
# CUSTOM_PORT=443
# CUSTOM_USE_HTTPS=true
# CUSTOM_PATH=/v1/chat/completions
# CUSTOM_MODEL=gpt-4o-mini
# CUSTOM_TEMPERATURE=0.8

# ===== 必填 =====

# JWT 密钥（用于 token 签发/验证）
JWT_SECRET=your-random-secret-at-least-32-chars

# ===== 可选 =====

# Admin 密钥（保护管理后台和模型切换，不设置则无认证保护）
# ADMIN_API_KEY=your-admin-secret-key

# CORS 允许的域名（逗号分隔，默认 localhost:8066）
# ALLOWED_ORIGINS=http://localhost:8066,https://yourdomain.com

# 端口号（默认 8066）
# PORT=8066
