# Soul Cosmos 环境变量配置
# 复制此文件为 .env 并填入实际值

# 必填：Mify 网关 API Key
MIFY_API_KEY=sk-your-api-key-here

# 可选：Stripe 支付（不配置则支付功能不可用）
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PRICE_MONTHLY=price_xxx
# STRIPE_PRICE_YEARLY=price_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# 可选：JWT 密钥（默认使用内置开发密钥）
# JWT_SECRET=your-secret-key

# 可选：端口号（默认 8066）
# PORT=8066
